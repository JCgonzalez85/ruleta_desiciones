# Variables de entorno para 39-ruleta-de-decisiones-api
# Nota de seguridad: Este archivo se llama env.example (sin punto inicial)
# porque las reglas de contencion de IA bloquean la lectura de cualquier archivo .env*
# Copie este archivo a .env.local para desarrollo local con emuladores o cuenta de desarrollo.

# ID del proyecto en Firebase
FIREBASE_PROJECT_ID=demo-ruleta-decisiones

# Email de la cuenta de servicio de Firebase Admin
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-stub@demo-ruleta-decisiones.iam.gserviceaccount.com

# Clave privada de Firebase Admin (con \n literales)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCLAVE_FALSA_DE_EJEMPLO_NO_USAR_EN_PRODUCCION\n-----END PRIVATE KEY-----\n"

# Clave de API Web de Firebase (usada por el backend para mediar con Firebase Auth REST API)
FIREBASE_WEB_API_KEY=AIzaSyDUMMY_WEB_API_KEY_EXAMPLE_00000

# Opcional: Host del emulador de Firestore y Auth para desarrollo local sin secretos reales
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
