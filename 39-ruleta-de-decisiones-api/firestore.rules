rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Regla de oro (Seccion 9.2): Acceso exclusivo desde la API mediante Firebase Admin SDK.
    // Ningun cliente movil o web tiene acceso directo a Firestore.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
