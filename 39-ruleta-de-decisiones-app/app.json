{
  "expo": {
    "name": "Ruleta de Decisiones",
    "slug": "39-ruleta-de-decisiones-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ruletadecisiones",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.universidad.ruletadedecisiones",
      "infoPlist": {
        "NSMotionUsageDescription": "La app utiliza el acelerómetro y el giroscopio para girar la ruleta al sacudir el teléfono y animar el brillo de los sectores al inclinarlo."
      }
    },
    "android": {
      "package": "com.universidad.ruletadedecisiones",
      "permissions": ["android.permission.VIBRATE"]
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-sqlite", "expo-status-bar"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
